# This .gitignore file is configured for Unity projects

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]serSettings/

# Asset meta files must be tracked in Unity, but some user settings files inside Assets should be ignored
/[Aa]ssets/[Aa]ssetStoreTools*

# Autogenerated VS/VS Code/Rider files
ExportedObj/
.consulo/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity 3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity WebGL build revision files
sysinfo.txt

# Crashlytics generated file
crashlytics-build.properties

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
